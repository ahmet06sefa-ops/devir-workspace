<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      v7.42 — Android 12+ KOYU tema widget renkleri.

      HATA: values-v31 klasörü vardı ama values-night-v31 YOKTU.
      Android 12+ cihazlarda koyu temaya geçildiğinde:
        · values-v31 kazanıyordu (daha spesifik nitelik)
        · w_text = system_neutral1_900 → KOYU renk
        · w_bg   = values-night'tan #1C1814 → KOYU zemin
      Sonuç: koyu zemin üzerine koyu yazı — widget okunmuyordu.

      Çözüm: koyu temada aydınlık ucundan (0-200) ton seçmek.
    -->
    <color name="w_bg">@android:color/system_neutral1_900</color>
    <color name="w_bg_alt">@android:color/system_neutral1_800</color>
    <color name="w_stroke">#33FFFFFF</color>
    <color name="w_text">@android:color/system_neutral1_50</color>
    <color name="w_text_soft">@android:color/system_neutral2_200</color>
    <color name="w_accent">@android:color/system_accent1_200</color>
    <color name="w_accent_soft">@android:color/system_accent1_800</color>
    <color name="w_green">@android:color/system_accent3_200</color>
    <color name="w_track">@android:color/system_neutral1_700</color>
    <color name="w_btn">@android:color/system_neutral1_800</color>
    <color name="w_ripple">#33FFFFFF</color>
</resources>
