    <!-- ==================================================================
         v8.2 · Öneri 6: Açılış ekranı (Splash Screen API)

         Önce ne vardı: uygulama açılırken beyaz bir kare görünüyor,
         sonra ana ekran zıplayarak geliyordu. Android 12+ zaten bir
         splash gösteriyor ama tema tanımlanmadığı için varsayılan
         beyaz/launcher ikonu çıkıyordu.

         core-splashscreen kütüphanesi bu temayı Android 6'ya kadar
         geriye taşıyor, yani tüm cihazlarda aynı açılış.
         ================================================================== -->
    <style name="Theme.GunlukAsistan.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#B08968</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ga_splash_ikon</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.GunlukAsistan</item>
    </style>

    <!-- ==================================================================
         v8.2 · Öneri 7: basılan kart içeri çöker.

         Tek tek 71 layout'a dokunmak yerine kart stilleri buradan
         türetiliyor; layout'larda yalnız style="@style/GaKart" yazmak
         yeterli oluyor.
         ================================================================== -->
    <style name="GaKart" parent="Widget.Material3.CardView.Filled">
        <item name="android:stateListAnimator">@animator/ga_kart_basma</item>
    </style>

    <style name="GaKartTiklanabilir" parent="GaKart">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="GaDugme" parent="Widget.Material3.Button">
        <item name="android:stateListAnimator">@animator/ga_dugme_basma</item>
    </style>
