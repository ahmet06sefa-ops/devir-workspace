<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <!-- Üst Başlık ve Geri Butonu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/colorSurfaceVariant"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnGeri"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/txtBaslik"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/ytp_activity_baslik"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/ga_yazi_orta" />
    </LinearLayout>

    <!-- Üst İşlem Butonu: Klasör Seç ve Yapay Zekâ ile Sırala -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/btnKlasorSecVeAiSirala"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:backgroundTint="?attr/colorPrimary"
            android:text="📁 Cihazdan Klasör Seç &amp; Yapay Zekâ ile Sırala"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="@dimen/ga_yazi_kucuk"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Oynatma Listesi Çip Seçici Bar (Her Oynatma Listesi Ayrı Sekmede) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutPlaylistCipleri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Seçili Oynatma Listesi Künyesi ve Temaya Uygun Yönetim Kartı -->
    <LinearLayout
        android:id="@+id/layoutPlaylistKunye"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="?attr/colorSurfaceVariant"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/txtPlaylistBaslik"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/ga_yazi_orta" />

        <TextView
            android:id="@+id/txtPlaylistDurum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/ga_yazi_kucuk"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnGrubuSil"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginTop="6dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="🗑️ Grubun Tamamını Sil"
            android:textColor="?attr/colorError"
            android:textSize="@dimen/ga_yazi_kucuk"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- v11.03: Profesyonel Kaydırma ve Taşıma Jest İpucu Şeridi -->
    <LinearLayout
        android:id="@+id/layoutJestBilgi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/g_card"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:id="@+id/txtJestBilgi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/ytp_jest_ipucu"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/ga_yazi_mini"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Boş Durum Bilgilendirme Kartı (Hiç Klasör Oynatma Listesi Olmadığında) -->
    <LinearLayout
        android:id="@+id/layoutBosKitaplik"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📁🤖"
            android:textSize="@dimen/ga_yazi_devasa" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:text="📁 Cihaz Klasörü &amp; Yapay Zekâ YouTube Sıralayıcı"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/ga_yazi_buyuk" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Telefonunuzdaki ders videoları klasörünü seçtiğinizde, yapay zekâ asistanı klasördeki videoları tarayarak YouTube oynatma listesine göre otomatik sıralar ve konu başlığını ayarlar.\n\nBaşlamak için yukarıdaki '📁 Cihazdan Klasör Seç &amp; Yapay Zekâ ile Sırala' butonuna dokunun."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/ga_yazi_normal" />
    </LinearLayout>

    <!-- v11.03: Profesyonel Kaydırılabilir &amp; Jest Destekli Video Sıralı Listesi (#1, #2, #3...) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listeYoutubeVideolar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />
</LinearLayout>
