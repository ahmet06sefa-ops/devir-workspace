<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    app:cardCornerRadius="@dimen/ga_kose_buyuk"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="68dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/accentBar"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:background="@color/sage" />

        <TextView
            android:importantForAccessibility="no"
            android:id="@+id/topicEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="4dp"
            android:text="📚"
            android:textSize="@dimen/ga_yazi_dev" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/homeTopicTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_semibold"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/ga_yazi_orta" />

            <TextView
                android:id="@+id/homeTopicCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/ga_yazi_kucuk" />
        </LinearLayout>

        <TextView
            android:id="@+id/homeTopicPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:paddingStart="8dp"
            android:paddingEnd="16dp"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/ga_yazi_orta" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
