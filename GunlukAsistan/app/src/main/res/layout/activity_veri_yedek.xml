<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <!-- Üst Başlık Barı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/colorSurfaceVariant"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnGeri"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/txtBaslik"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_semibold"
            android:text="💾 Tüm Verileri Yedekle &amp; Geri Yükle"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/ga_yazi_orta" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Bilgi Kartı -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="@dimen/ga_kose_orta">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🛡️ Tüm Verilerinizi Tek Dosyada Koruyun"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/ga_yazi_orta"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Bu ekran, uygulamanızdaki tüm ayar ve veri anahtarlarını (görünüm, Canva modülü, görev tercihleri, tema vs.) tek bir JSON yedeğine çevirir. Dışa aktardığınız dosyayı WhatsApp, Google Drive, bulut veya dosya yöneticisi üzerinden istediğiniz yere kaydedebilirsiniz. Geri yüklemede veri bütünlüğü sağlama değeriyle (CRC32) doğrulanır."
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/ga_yazi_kucuk" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Dışa Aktar -->
            <Button
                android:id="@+id/btnDisarAktar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:backgroundTint="?attr/colorPrimary"
                android:padding="14dp"
                android:text="📤 Tüm Verileri Dışa Aktar (Paylaş)"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="@dimen/ga_yazi_normal"
                android:textStyle="bold" />

            <!-- İçe Aktar -->
            <Button
                android:id="@+id/btnIcerAktar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:backgroundTint="?attr/colorSecondaryContainer"
                android:padding="14dp"
                android:text="📥 Yedekten Geri Yükle (Dosya Seç)"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:textSize="@dimen/ga_yazi_normal"
                android:textStyle="bold" />

            <!-- Son Yedek / Durum Kartı -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="@dimen/ga_kose_orta">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📋 Durum"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/ga_yazi_orta"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDurum"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Henüz dışa aktarma yapılmadı. \n\nDışa Aktar'ı kullanarak tüm verilerinizi tek dosyada yedekleyin."
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/ga_yazi_kucuk" />

                    <TextView
                        android:id="@+id/txtSaglama"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Sağlama: —"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="@dimen/ga_yazi_mini"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
