<?xml version="1.0" encoding="utf-8"?>
<!--
  v10.10 · ULTRA-50 C34: Hafta görünümü widget'ı.
  Üst şerit (hafta aralığı) + 7 günlük şerit:
  her hücrede gün adı, tarih, plan işareti (doluluk), kalan görev rozeti.
  RemoteViews kısıtı: yalnız LinearLayout/TextView — dokunuşlar
  çalışma anında setOnClickPendingIntent ile bağlanır; renkler
  çalışma anında WidgetTema ile basılır (XML'deki renk ilk kare içindir).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/hwBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hwRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Üst şerit: başlık + hafta aralığı -->
    <LinearLayout
        android:id="@+id/hwHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/hwTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_semibold"
            android:maxLines="1"
            android:text="@string/hw_baslik"
            android:textColor="@color/w_text"
            android:textSize="@dimen/ga_yazi_orta" />

        <TextView
            android:id="@+id/hwRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/w_text"
            android:textSize="@dimen/ga_yazi_kucuk" />
    </LinearLayout>

    <!-- Plan kapalıysa görünen ipucu satırı -->
    <TextView
        android:id="@+id/hwNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingBottom="6dp"
        android:text=""
        android:textColor="@color/w_text"
        android:textSize="@dimen/ga_yazi_kucuk"
        android:visibility="gone" />

    <!-- 7 günlük şerit -->
