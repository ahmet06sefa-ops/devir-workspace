<?xml version="1.0" encoding="utf-8"?>
<!-- v11.64: Sağlık Karnesi widget'ı (4×2) — beslenme/su/uyku/ruh hali özeti -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/sgBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/sgRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/sgTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/wg_saglik_baslik"
            android:textColor="@color/w_text"
            android:textSize="@dimen/ga_yazi_normal" />

        <TextView
            android:id="@+id/sgBeslenme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/w_text"
            android:textSize="@dimen/ga_yazi_kucuk" />

        <TextView
            android:id="@+id/sgSu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/w_text_soft"
            android:textSize="@dimen/ga_yazi_kucuk" />

        <TextView
            android:id="@+id/sgUyku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/w_text_soft"
            android:textSize="@dimen/ga_yazi_kucuk" />

        <TextView
            android:id="@+id/sgMood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/w_text_soft"
            android:textSize="@dimen/ga_yazi_kucuk" />
    </LinearLayout>
</FrameLayout>
