<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/tasksBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tasksRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/w_kart_pay">

    <!-- Başlık şeridi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/twTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-light"
            android:text="@string/w_tasks_title"
            android:textColor="@color/w_text"
            android:textSize="@dimen/ga_yazi_orta"
            android:textStyle="normal" />

        <!-- v10.13 · B12: örnek bazlı etiket filtresi çipi -->
        <TextView
            android:id="@+id/twFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/w_btn_accent"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="@string/wg_etiket_btn"
            android:textColor="@color/w_accent"
            android:textSize="@dimen/ga_yazi_kucuk" />

        <TextView
            android:id="@+id/twAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/w_btn_accent"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="@string/w_add"
            android:textColor="@color/w_accent"
            android:textSize="@dimen/ga_yazi_kucuk" />
    </LinearLayout>

    <!-- Kaydırılabilir görev listesi (boşken twEmpty gösterilir) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/twList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/twEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/w_tasks_empty"
            android:textColor="@color/w_text_soft"
            android:textSize="@dimen/ga_yazi_kucuk"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
</FrameLayout>
