<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:background="@drawable/g_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/txtCanvaSimge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏱️"
        android:textSize="@dimen/ga_yazi_normal" />

    <TextView
        android:id="@+id/txtCanvaAd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="Çalışma Zamanı"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/ga_yazi_kucuk"
        android:textStyle="bold" />

    <CheckBox
        android:id="@+id/chkCanvaAcKapa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:buttonTint="?attr/colorPrimary" />
</LinearLayout>
