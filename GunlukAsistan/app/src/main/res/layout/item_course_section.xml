<?xml version="1.0" encoding="utf-8"?>
<!-- v7.4: bölüm satırı (kurs içinde girintili) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingTop="13dp"
    android:paddingEnd="16dp"
    android:paddingBottom="13dp">

    <View
        android:layout_width="3dp"
        android:layout_height="26dp"
        android:layout_marginEnd="12dp"
        android:background="#8A97A8" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/isTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/ga_yazi_normal"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/isMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="@dimen/ga_yazi_mini" />
    </LinearLayout>

    <TextView
            android:importantForAccessibility="no"
        android:id="@+id/isChevron"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="@dimen/ga_yazi_buyuk" />
</LinearLayout>
