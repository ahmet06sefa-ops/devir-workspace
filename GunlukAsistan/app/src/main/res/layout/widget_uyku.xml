<?xml version="1.0" encoding="utf-8"?>
<!--
  v10.13 · ULTRA-30 / B9 — Uyku widget'ı (4×2).

  Son 7 gecenin çubuk grafiği kodda bitmap olarak üretilip uyGrafik'e
  basılır; plan çizgisi kesiklidir. Gövde dokunması (uyRoot) uyku
  ayarlarını açar.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/uyBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/uyRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/w_kart_pay">

        <TextView
            android:id="@+id/uyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/wg_uyku_baslik"
            android:textColor="@color/w_text"
            android:textSize="@dimen/ga_yazi_normal" />

        <ImageView
            android:id="@+id/uyGrafik"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:scaleType="fitXY" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/uyOrt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/w_text_soft"
                android:textSize="@dimen/ga_yazi_kucuk" />

            <TextView
                android:id="@+id/uyHedef"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/w_text_soft"
                android:textSize="@dimen/ga_yazi_kucuk" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
