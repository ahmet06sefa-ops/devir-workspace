<?xml version="1.0" encoding="utf-8"?>
<!-- v7.39: PDF içinde tam metin arama -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <!-- Üst bar: geri + arama kutusu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp">

        <TextView
            android:contentDescription="@string/cd_kapat"
            android:id="@+id/psClose"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="✕"
            android:textSize="@dimen/ga_yazi_buyuk" />

        <EditText
            android:id="@+id/psInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/ps_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="@dimen/ga_yazi_orta" />

        <TextView
            android:contentDescription="@string/cd_ara"
            android:id="@+id/psSearch"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="🔍"
            android:textSize="@dimen/ga_yazi_buyuk" />
    </LinearLayout>

    <!-- Durum satırı -->
    <TextView
        android:id="@+id/psStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.75"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="6dp"
        android:textSize="@dimen/ga_yazi_kucuk" />

    <!-- İndeksleme ilerlemesi -->
    <LinearLayout
        android:id="@+id/psProgressBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/psProgressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="@dimen/ga_yazi_kucuk" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/psProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:trackCornerRadius="3dp"
            app:trackThickness="4dp" />
    </LinearLayout>

    <!-- Sonuç listesi -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/psResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="2dp"
            android:paddingEnd="14dp"
            android:paddingBottom="20dp" />
    </ScrollView>

    <!-- Alt bilgi: indeks durumu + tümünü indeksle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="4dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/psIndexInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:alpha="0.7"
            android:textSize="@dimen/ga_yazi_mini" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/psIndexAll"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ps_index_all"
            android:textSize="@dimen/ga_yazi_kucuk" />
    </LinearLayout>
</LinearLayout>
