<?xml version="1.0" encoding="utf-8"?>
<!--
  v10.5 · C32 — Hedef halkası widget'ı (1×1 / 2×1).
  RemoteViews'ta özel View çizilemediği için "halka" hissi büyük
  yüzde + ince bar ile verilir.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/hdBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hdRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/hdYuzde"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:includeFontPadding="false"
        android:text="%0"
        android:textColor="@color/w_accent"
        android:textSize="@dimen/ga_yazi_dev" />

    <ProgressBar
        android:id="@+id/hdBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0" />

    <TextView
        android:id="@+id/hdAlt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/hd_alt_varsayilan"
        android:textColor="@color/w_text_soft"
        android:textSize="@dimen/ga_yazi_mini" />
</LinearLayout>
</FrameLayout>
