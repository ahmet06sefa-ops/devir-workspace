<?xml version="1.0" encoding="utf-8"?>
<!-- v7.33: Bilgi kartı çalışma ekranı -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp">

        <TextView
            android:contentDescription="@string/cd_kapat"
            android:id="@+id/kzClose"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="✕"
            android:textSize="@dimen/ga_yazi_buyuk" />

        <TextView
            android:id="@+id/kzDeck"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textSize="@dimen/ga_yazi_normal"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/kzCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/ga_yazi_normal"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/kzProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        app:trackCornerRadius="3dp"
        app:trackThickness="5dp" />

    <!-- Kart -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/kzCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="18dp"
        android:layout_weight="1"
        android:clickable="true"
    android:foreground="?attr/selectableItemBackground"
        android:focusable="true"
        app:cardCornerRadius="@dimen/ga_kose_buyuk"
        app:cardElevation="0dp"
        app:strokeWidth="2dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="220dp"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/kzSide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="@string/card_front"
                    android:textSize="@dimen/ga_yazi_mini"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/kzText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:textIsSelectable="true"
                    android:textSize="@dimen/ga_yazi_buyuk"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/kzHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:textSize="@dimen/ga_yazi_normal"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/kzTapHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:text="@string/card_tap"
                    android:textSize="@dimen/ga_yazi_kucuk" />
            </LinearLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!-- Cevap düğmeleri -->
    <LinearLayout
        android:id="@+id/kzButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="20dp"
        android:visibility="invisible">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/kzAgain"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:text="@string/card_again"
            android:textSize="@dimen/ga_yazi_normal"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/kzKnow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:text="@string/card_know"
            android:textSize="@dimen/ga_yazi_normal"
            app:cornerRadius="14dp" />
    </LinearLayout>
</LinearLayout>
