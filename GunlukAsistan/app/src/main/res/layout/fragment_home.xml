            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/txtMotivasyonSozu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📜 &quot;Zorluklar zihni güçlendirir, tıpkı çalışmanın bedeni güçlendirdiği gibi.&quot; — Seneca [Stoacı Felsefe]"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/ga_yazi_normal"
                    android:textStyle="italic" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnMotivasyonYenile"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:foreground="?attr/selectableItemBackground"
                        android:text="@string/mmn_btn_yenile"
                        android:textSize="@dimen/ga_yazi_mini" />

                    <Button
                        android:id="@+id/btnMotivasyonSabitle"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:foreground="?attr/selectableItemBackground"
                        android:text="@string/mmn_btn_sabitle"
                        android:textSize="@dimen/ga_yazi_mini" />

                    <Button
                        android:id="@+id/btnMotivasyonPaylas"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:foreground="?attr/selectableItemBackground"
                        android:text="@string/mmn_btn_paylas"
                        android:textSize="@dimen/ga_yazi_mini" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.gunlukasistan.app.DuzenBlokLayout android:id="@+id/blokHero" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="@android:color/transparent" app:cardCornerRadius="@dimen/ga_kose_buyuk" app:cardElevation="0dp">
