<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    app:cardCornerRadius="@dimen/ga_kose_buyuk"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="70dp"
        android:orientation="horizontal">

        <!-- v9.9 · Görsel öneri 11: aciliyet şeridi.
             Kalan güne göre renkleniyor; gözle tarama hızını artırıyor. -->
        <View
            android:id="@+id/eventSerit"
            android:layout_width="4dp"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/eventEmoji"
            android:layout_marginStart="10dp"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:gravity="center"
            android:textSize="@dimen/ga_yazi_dev"
            tools:ignore="SpUsage" />

        <LinearLayout
            android:layout_width="0dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/eventTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_semibold"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/ga_yazi_orta" />

            <TextView
                android:id="@+id/eventDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/ga_yazi_kucuk" />
        </LinearLayout>

        <TextView
            android:id="@+id/eventDays"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/poppins_bold"
            android:gravity="end"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/ga_yazi_orta" />

        <ImageView
            android:id="@+id/eventDelete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/delete"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
