<?xml version="1.0" encoding="utf-8"?>
<!-- v7.20: Kaynak Merkezi — yapay zekâ ile bulunan PDF ve videolar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/krHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/src_center_title"
            android:textSize="@dimen/ga_yazi_buyuk"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/krFilterBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:text="@string/src_filter_all"
            android:textSize="@dimen/ga_yazi_normal"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/krSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:textSize="@dimen/ga_yazi_kucuk" />

    <!-- v7.21: Yeni kurs üretme kartı -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="@dimen/ga_kose_orta"
        app:cardElevation="0dp"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gen_header"
                android:textSize="@dimen/ga_yazi_normal"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:text="@string/gen_sub"
                android:textSize="@dimen/ga_yazi_mini" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/krNewCourse"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gen_new_course"
                android:textSize="@dimen/ga_yazi_normal" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Arama kartı -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="@dimen/ga_kose_orta"
        app:cardElevation="0dp"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/src_find_header"
                android:textSize="@dimen/ga_yazi_normal"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/krLessonPick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="8dp"
                android:padding="10dp"
                android:text="@string/src_pick_lesson"
                android:textSize="@dimen/ga_yazi_normal"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/krFindPdf"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/src_find_pdf"
                    android:textSize="@dimen/ga_yazi_normal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/krFindVideo"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/src_find_video"
                    android:textSize="@dimen/ga_yazi_normal" />
            </LinearLayout>

            <!-- v7.21: tek tuşla hepsini bul -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/krAutoAll"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/gen_auto_all"
                android:textSize="@dimen/ga_yazi_kucuk" />

            <TextView
                android:id="@+id/krAiWarn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/src_ai_needed"
                android:textSize="@dimen/ga_yazi_mini"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/krRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="90dp" />

    <TextView
        android:id="@+id/krEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:paddingStart="34dp"
        android:paddingEnd="34dp"
        android:text="@string/src_empty"
        android:textSize="@dimen/ga_yazi_normal"
        android:visibility="gone" />
</LinearLayout>
