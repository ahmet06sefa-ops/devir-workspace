<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Üst Başlık ve Geri Butonu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/btnGeri"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/app_name"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="?attr/colorOnSurface" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtBaslik"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/agm_baslik"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/ga_yazi_buyuk"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtAltBaslik"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/agm_altbaslik"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/ga_yazi_kucuk" />
            </LinearLayout>
        </LinearLayout>

        <!-- KART 1: Modül 1 - Sabah / Akşam Gündem Brifingi -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="@dimen/ga_kose_orta"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/agm_mod1_brifing"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/ga_yazi_normal"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtBrifingSonuc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="🌅 Sabah Brifingi: Günaydın! Bugün 4 kilit ders göreviniz ve 16:8 aralıklı oruç takibiniz var."
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/ga_yazi_kucuk" />

                <Button
                    android:id="@+id/btnBrifingTest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="@string/agm_btn_brifing_test"
                    android:textSize="@dimen/ga_yazi_kucuk" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- KART 2: Modül 2 & 4 - 24-Saatlik Biyo-Vakit & Akıllı DND Kalkanı -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="@dimen/ga_kose_orta"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/agm_mod2_biyo"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/ga_yazi_normal"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtBiyoVeDnd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="🕰️ Biyo-Vakit Bloku: 14:00 - 17:00 Öğleden Sonra Pratik Bloku (40 Hz Gamma Önerilir)\n🔕 Akıllı Rahatsız Etme (DND): Hazır"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/ga_yazi_kucuk" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- KART 3: Modül 3 & 6 - Bugün Ne Yapmalıyım? & Sokratik Koç -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="@dimen/ga_kose_orta"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 Otonom Karar Asistanı &amp; Sokratik Koç (#29, #70)"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/ga_yazi_normal"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtOneriVeSokratik"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="💡 Öneri: 'Leitner 1. Kutudan 15 Flaş Kart Çöz' (+25 XP)\n🦉 Sokratik Koç: Çalışmak için en küçük adımdan başla!"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/ga_yazi_kucuk" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnOneriTest"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:foreground="?attr/selectableItemBackground"
                        android:text="@string/agm_btn_oneri_test"
                        android:textSize="@dimen/ga_yazi_kucuk" />

                    <Button
                        android:id="@+id/btnSokratikTest"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:foreground="?attr/selectableItemBackground"
                        android:text="@string/agm_btn_sokratik_test"
                        android:textSize="@dimen/ga_yazi_kucuk" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- KART 4: Modül 5 & 7 - Haftalık Bütüncül Yaşam/Ders Raporu & Çevrimdışı Yedek -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="@dimen/ga_kose_orta"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/agm_mod5_rapor"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/ga_yazi_normal"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtRaporSonuc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="🏆 Haftalık Bütüncül Karne: A+ (28 Saat Ders · %92 Sağlık)\n✅ %100 Çevrimdışı Yerel Yedek Doğrulandı"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/ga_yazi_kucuk" />

                <Button
                    android:id="@+id/btnRaporTest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="@string/agm_btn_rapor_test"
                    android:textSize="@dimen/ga_yazi_kucuk" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
