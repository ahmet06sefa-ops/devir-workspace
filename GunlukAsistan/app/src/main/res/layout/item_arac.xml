<?xml version="1.0" encoding="utf-8"?>
<!-- v7.30: Araç / yönetmelik listesi satırı -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="@dimen/ga_kose_orta"
    app:cardElevation="0dp"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="13dp">

        <TextView
            android:id="@+id/iaIcon"
            android:layout_width="38dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="@dimen/ga_yazi_buyuk" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/iaTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/ga_yazi_normal"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/iaSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="1dp"
                android:textSize="@dimen/ga_yazi_kucuk" />

            <TextView
                android:id="@+id/iaSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:textSize="@dimen/ga_yazi_mini"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/iaArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/co_resume_go"
            android:textSize="@dimen/ga_yazi_orta" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
