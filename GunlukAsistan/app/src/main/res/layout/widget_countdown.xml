<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/cdBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cdRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/w_kart_pay">

    <TextView
        android:id="@+id/cdEmoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎯"
        android:textSize="@dimen/ga_yazi_buyuk" />

    <TextView
        android:id="@+id/cdDays"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:fontFamily="@font/poppins_bold"
        android:includeFontPadding="false"
        android:text="—"
        android:textColor="@color/w_accent"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/cdLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/w_no_event"
        android:textColor="@color/w_text_soft"
        android:textSize="@dimen/ga_yazi_mini" />
</LinearLayout>
</FrameLayout>
