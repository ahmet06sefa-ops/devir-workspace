<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/g_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <CheckBox
        android:id="@+id/chkResetGorev"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="?attr/colorPrimary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtResetKategori"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/ga_yazi_mini"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtResetBaslik"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/ga_yazi_normal" />
    </LinearLayout>

    <Button
        android:id="@+id/btnResetGorevSil"
        style="?attr/borderlessButtonStyle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="🗑️"
        android:textColor="?attr/colorError"
        android:textSize="@dimen/ga_yazi_normal" />
</LinearLayout>
