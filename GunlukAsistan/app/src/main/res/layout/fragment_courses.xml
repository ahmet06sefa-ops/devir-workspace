<?xml version="1.0" encoding="utf-8"?>
<!-- v7.4: Mühendislik kursları ekranı -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Başlık -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/co_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/ga_yazi_dev"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/coSummary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/co_summary_empty"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="@dimen/ga_yazi_normal" />

                <!-- v7.8: yer imi filtresi -->
                <TextView
                    android:id="@+id/coFavFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/co_fav_filter_off"
                    android:textSize="@dimen/ga_yazi_orta" />
            </LinearLayout>
        </LinearLayout>

        <!-- v7.7: ders/kurs arama -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="6dp"
            android:hint="@string/co_search_hint"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:startIconDrawable="@android:drawable/ic_menu_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/coSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="@dimen/ga_yazi_normal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- v7.39: ders PDF'lerinin İÇİNDE arama -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/coPdfSearch"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/ps_menu"
            android:textSize="@dimen/ga_yazi_normal"
            app:cornerRadius="14dp" />

        <!-- v7.29: bugün tekrar edilecek dersler -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/coReviewCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
    android:foreground="?attr/selectableItemBackground"
            android:focusable="true"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/ga_kose_orta"
            app:cardElevation="0dp"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="11dp"
                android:paddingEnd="14dp"
                android:paddingBottom="11dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:text="@string/rev_icon"
                    android:textSize="@dimen/ga_yazi_dev" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/rev_label"
                        android:textSize="@dimen/ga_yazi_mini"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/coReviewText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textSize="@dimen/ga_yazi_normal"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/co_resume_go"
                    android:textSize="@dimen/ga_yazi_buyuk" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- v7.16: kaldığın yerden devam kartı -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/coResumeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
    android:foreground="?attr/selectableItemBackground"
            android:focusable="true"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/ga_kose_orta"
            app:cardElevation="0dp"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="11dp"
                android:paddingEnd="14dp"
                android:paddingBottom="11dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:text="@string/co_resume_icon"
                    android:textSize="@dimen/ga_yazi_dev" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/coResumeLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/co_resume_title"
                        android:textSize="@dimen/ga_yazi_mini"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/coResumeTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:maxLines="2"
                        android:textSize="@dimen/ga_yazi_normal"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/coResumeSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:maxLines="1"
                        android:textSize="@dimen/ga_yazi_mini" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/co_resume_go"
                    android:textSize="@dimen/ga_yazi_buyuk" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/coRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="96dp" />

        <!-- Boş durum -->
        <LinearLayout
            android:id="@+id/coEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏗"
                android:textSize="56sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/co_empty_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/ga_yazi_buyuk"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/co_empty_sub"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="@dimen/ga_yazi_normal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/coInstall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:text="@string/co_install_pack"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/coFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="@string/co_new_course"
        app:srcCompat="@drawable/ic_add" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
