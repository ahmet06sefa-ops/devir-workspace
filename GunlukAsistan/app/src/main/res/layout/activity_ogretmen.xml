<?xml version="1.0" encoding="utf-8"?>
<!-- v7.37: Özel öğretmen modu — anlatım + anlama sorusu -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <!-- Üst bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <TextView
            android:contentDescription="@string/cd_kapat"
            android:id="@+id/ogClose"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="✕"
            android:textSize="@dimen/ga_yazi_buyuk" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ogTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="@dimen/ga_yazi_normal"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ogSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.75"
                android:maxLines="1"
                android:textSize="@dimen/ga_yazi_mini" />
        </LinearLayout>

        <!-- Seviye rozeti -->
        <TextView
            android:id="@+id/ogLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:textSize="@dimen/ga_yazi_kucuk"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/ogProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        app:trackCornerRadius="3dp"
        app:trackThickness="5dp" />

    <ScrollView
        android:id="@+id/ogScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <!-- Bu adımın konu başlığı -->
            <TextView
                android:id="@+id/ogTopic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textSize="@dimen/ga_yazi_orta"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Anlatım metni -->
            <TextView
                android:id="@+id/ogLesson"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="5dp"
                android:textIsSelectable="true"
                android:textSize="@dimen/ga_yazi_orta" />

            <!-- Anlama sorusu -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ogQuestionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/ga_kose_orta"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/ogQuestion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:lineSpacingExtra="2dp"
                        android:textSize="@dimen/ga_yazi_orta"
                        android:textStyle="bold" />

                    <!-- Şıklar kod ile eklenir -->
                    <LinearLayout
                        android:id="@+id/ogOptions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- Serbest cevap alanı -->
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ogAnswerInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/tut_answer_hint"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLines="4"
                        android:minLines="2"
                        android:textSize="@dimen/ga_yazi_normal"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Geri bildirim -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ogFeedbackCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/ga_kose_orta"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/ogVerdict"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/ga_yazi_normal"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/ogFeedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:lineSpacingExtra="2dp"
                        android:textSize="@dimen/ga_yazi_normal" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- Bekleme göstergesi -->
    <LinearLayout
        android:id="@+id/ogLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:indeterminate="true"
            app:indicatorSize="22dp"
            app:trackThickness="2dp" />

        <TextView
            android:id="@+id/ogLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/tut_thinking"
            android:textSize="@dimen/ga_yazi_normal" />
    </LinearLayout>

    <!-- Alt düğmeler -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="4dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ogSimpler"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/tut_simpler"
            android:textSize="@dimen/ga_yazi_normal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ogNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tut_next"
            app:cornerRadius="14dp" />
    </LinearLayout>
</LinearLayout>
