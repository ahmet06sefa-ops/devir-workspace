<?xml version="1.0" encoding="utf-8"?>
<!-- v10.5 · C31 — geri sayım satırı: emoji · ad · kalan gün -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/evRowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/evRowEmoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎯"
        android:textSize="@dimen/ga_yazi_orta" />

    <TextView
        android:id="@+id/evRowAd"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/ev_ornek"
        android:textColor="@color/w_text"
        android:textSize="@dimen/ga_yazi_kucuk" />

    <TextView
        android:id="@+id/evRowGun"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/w_accent"
        android:textSize="@dimen/ga_yazi_kucuk" />
</LinearLayout>
