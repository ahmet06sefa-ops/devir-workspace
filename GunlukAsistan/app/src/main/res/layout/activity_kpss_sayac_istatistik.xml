<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Üst Başlık ve Geri Butonu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="16dp">

            <ImageButton
                android:id="@+id/btnGeri"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/app_name"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/ksa_istatistik_baslik"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/ga_yazi_buyuk"
                android:textStyle="bold" />

            <View
                android:layout_width="40dp"
                android:layout_height="40dp" />
        </LinearLayout>

        <!-- 3'lü Özet Hap Kartları (Ekran Görüntüsü 3 - Üst) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="@dimen/ga_kose_kucuk"
                app:cardElevation="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/txtToplamDk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:text="0\nDakika"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/ga_yazi_kucuk"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="@dimen/ga_kose_kucuk"
                app:cardElevation="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/txtToplamPomo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:text="0\nPomodoro"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/ga_yazi_kucuk"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="@dimen/ga_kose_kucuk"
                app:cardElevation="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/txtAktifGun"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:text="0\nGün"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/ga_yazi_kucuk"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- KART: Ağustos 2026 Takvim Izgarası & Günlük Yeşil Durum Bandı (Ekran Görüntüsü 3 - Orta) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="@dimen/ga_kose_orta"
            app:cardElevation="2dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Ay başlığı ve < > okları -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnAyOnceki"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center"
                        android:text="‹"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/ga_yazi_buyuk" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Ağustos 2026"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/ga_yazi_normal"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnAySonraki"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/ga_yazi_buyuk" />
                </LinearLayout>

                <!-- Haftanın Günleri Başlığı -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Pzt" android:textSize="@dimen/ga_yazi_mini" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Sal" android:textSize="@dimen/ga_yazi_mini" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Çar" android:textSize="@dimen/ga_yazi_mini" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Per" android:textSize="@dimen/ga_yazi_mini" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Cum" android:textSize="@dimen/ga_yazi_mini" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Cmt" android:textSize="@dimen/ga_yazi_mini" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Paz" android:textSize="@dimen/ga_yazi_mini" />
                </LinearLayout>

                <!-- 31 Günlük Izgara -->
                <LinearLayout
                    android:id="@+id/layoutTakvimIzgara"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <!-- Yeşil Günlük Durum Bandı (Ekran Görüntüsü 3 - Alt) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="?attr/colorPrimaryContainer"
                    app:cardCornerRadius="@dimen/ga_kose_kucuk"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/txtBugunTarihBanner"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pazartesi, 10.08.2026"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/ga_yazi_kucuk"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtBugunDurumBanner"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Henüz çalışmadın"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/ga_yazi_kucuk" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- İlk Adımı At Koyu Hap Bandı (Ekran Görüntüsü 3) -->
        <TextView
            android:id="@+id/txtIlkAdimBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="?attr/colorSecondaryContainer"
            android:gravity="center"
            android:paddingVertical="14dp"
            android:text="Henüz çalışmaya başlamadın. İlk adımı at"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/ga_yazi_kucuk"
            android:textStyle="bold" />

        <!-- En Altta: Çalışma Süresi Ekle Butonu -->
        <Button
            android:id="@+id/btnManuelSureEkle"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:foreground="?attr/selectableItemBackground"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="@string/ksa_btn_sure_ekle"
            android:textSize="@dimen/ga_yazi_kucuk" />

    </LinearLayout>
</ScrollView>
