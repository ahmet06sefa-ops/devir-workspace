<?xml version="1.0" encoding="utf-8"?>
<!--
  v10.13 · ULTRA-30 / B7 — Kokpit süper widget (4×2).

  Kökte ImageView'li FrameLayout: arka plan bitmap'i çalışma anında
  üretildiği için köşe yarıçapı ve saydamlık kaydırıcılarından
  etkilenir (B11). Üç dokunma bölgesi çizimde TextView/LinearLayout
  olarak durur; tıklama PendingIntent'leri kodda bağlanır.

  Saat, sistem tarafından işlenen TextClock'tur (pil harcamaz);
  kadran bitmap'i ise dakikada bir tazelendiğinde ibreleri gösterir.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/kpBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/w_kart_pay">

        <!-- Bölge 1: kadran + saat (→ sayaç ekranı) -->
        <LinearLayout
            android:id="@+id/kpBolgeSayac"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/kpDial"
                android:layout_width="88dp"
                android:layout_height="88dp" />

            <TextClock
                android:id="@+id/kpSaat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins_semibold"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="@color/w_text"
                android:textSize="@dimen/ga_yazi_normal" />

            <TextClock
                android:id="@+id/kpGun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="d MMM, EEE"
                android:format24Hour="d MMM, EEE"
                android:textColor="@color/w_text_soft"
                android:textSize="@dimen/ga_yazi_mini" />
        </LinearLayout>

        <!-- Bölge 2: sıradaki iki görev (→ görevler ekranı) -->
        <LinearLayout
            android:id="@+id/kpBolgeGorev"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/kpUst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wg_kokpit_ust"
                android:textColor="@color/w_text_soft"
                android:textSize="@dimen/ga_yazi_mini" />

            <TextView
                android:id="@+id/kpGorev1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/w_text"
                android:textSize="@dimen/ga_yazi_kucuk" />

            <TextView
                android:id="@+id/kpGorev2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/w_text_soft"
                android:textSize="@dimen/ga_yazi_kucuk" />
        </LinearLayout>

        <!-- Bölge 3: seri halkası (→ ana ekran) -->
        <LinearLayout
            android:id="@+id/kpBolgeSeri"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/kpSeriYuz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥"
                android:textSize="@dimen/ga_yazi_buyuk" />

            <TextView
                android:id="@+id/kpSeriSayi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/w_text"
                android:textSize="@dimen/ga_yazi_kucuk" />

            <TextView
                android:id="@+id/kpSeriEtiket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wg_seri_etiket"
                android:textColor="@color/w_text_soft"
                android:textSize="@dimen/ga_yazi_mini" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
