<?xml version="1.0" encoding="utf-8"?>
<!--
  v11.13: Asistan ekranı Gemini tarzı modern tasarıma dönüştürüldü.
  Gradyan header + yuvarlak giriş çubuğu + avatar.
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/asistanDrawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ── Ana içerik ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Gemini tarzı üst bar (gradyan) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ai_header_gradient"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Avatar -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardCornerRadius="@dimen/ga_kose_tam"
                    app:cardBackgroundColor="?attr/colorPrimary"
                    app:cardElevation="2dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="✨"
                        android:textSize="@dimen/ga_yazi_buyuk" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/asistanBaslik"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_semibold"
                        android:maxLines="1"
                        android:text="@string/asistan_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/ga_yazi_buyuk" />

                    <TextView
                        android:id="@+id/asistanCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/asistan_caption"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/ga_yazi_mini" />
                </LinearLayout>

                <!-- v7.60: geçmiş panelini aç -->
                <TextView
                    android:id="@+id/sohbetlerimBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/sg_panel_ac"
                    android:gravity="center"
                    android:text="💬"
                    android:textSize="@dimen/ga_yazi_buyuk" />

                <!-- v11.13: sesli asistan aç/kapa -->
                <TextView
                    android:id="@+id/sesliAsistanBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/asistan_ses_ac_kapa"
                    android:gravity="center"
                    android:text="🔊"
                    android:textSize="@dimen/ga_yazi_buyuk" />

                <TextView
                    android:id="@+id/yeniSohbetBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/sg_yeni"
                    android:gravity="center"
                    android:text="✚"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/ga_yazi_buyuk" />
            </LinearLayout>

            <!-- mod rozeti -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/aiModeChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ai_mode_chip"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="@string/ai_chip_offline"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textSize="@dimen/ga_yazi_mini"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sohbet alanı -->
        <ScrollView
            android:id="@+id/chatScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:id="@+id/chatContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="8dp" />
        </ScrollView>

        <!-- Hazır soru çipleri -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:id="@+id/chipRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- v11.13: sesli asistan durum çipi -->
        <TextView
            android:id="@+id/sesliDurumTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/sa_dinliyorum"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/ga_yazi_kucuk"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Gemini tarzı yuvarlak giriş çubuğu -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="@dimen/ga_kose_tam"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="6dp">

                <EditText
                    android:id="@+id/chatInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/asistan_hint"
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences"
                    android:maxLines="2"
                    android:minHeight="44dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/ga_yazi_normal" />

                <ImageButton
                    android:id="@+id/micButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/mic_cd"
                    android:src="@drawable/ic_mic"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <ImageButton
                    android:id="@+id/sendButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/ai_send_round"
                    android:contentDescription="@string/send_cd"
                    android:padding="10dp"
                    android:src="@drawable/ic_send"
                    app:tint="?attr/colorOnPrimary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- ── Sağdan açılan geçmiş paneli ── -->
    <LinearLayout
        android:id="@+id/sohbetPanel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="?attr/colorSurface"
        android:orientation="vertical"
        android:paddingTop="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/sg_panel"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/ga_yazi_buyuk" />

            <TextView
                android:id="@+id/panelSayac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/ga_yazi_kucuk" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/panelYeniBtn"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="14dp"
            android:fontFamily="@font/poppins_medium"
            android:text="@string/sg_yeni" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/panelListe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp" />
        </ScrollView>

        <TextView
            android:id="@+id/panelYonetBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp"
            android:text="@string/sg_tumunu_yonet"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/ga_yazi_normal" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
