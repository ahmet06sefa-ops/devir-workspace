<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- v7.86: başlık + sağ üstte ayarlar düğmesi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/ksa_baslik"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/ga_yazi_dev" />

            <TextView
                android:id="@+id/timerSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sa_baslik"
                android:gravity="center"
                android:text="⋮"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/ga_yazi_dev" />
        </LinearLayout>

        <!-- v10.78: Oturum Hapı (Oturum: 1 / 4) -->
        <TextView
            android:id="@+id/txtSayacOturumPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_chip_sage"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp"
            android:text="@string/ksa_oturum_default"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/ga_yazi_kucuk"
            android:textStyle="bold" />

        <!-- Mod seçimi: Geri Sayım / Kronometre -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/modeToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/countdownButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/countdown" />

            <!-- v10.24: kronometre ile geri sayımın ortasına ileri sayım -->
            <Button
                android:id="@+id/ileriButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/w23_ileri" />

            <Button
                android:id="@+id/watchButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/stopwatch" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- v7.85: halka kadranlı geri sayım göstergesi.
             Eski timeText kaldırılmadı — kadranın içinde süre kendisi
             çiziliyor ama kod hâlâ timeText'e yazıyor. Görünmez tutulup
             (GONE) tek gerçek kaynak korunuyor; böylece TimerFragment'in
             tüm güncelleme mantığı olduğu gibi çalışmaya devam ediyor. -->
        <com.gunlukasistan.app.SayacKadraniView
            android:id="@+id/sayacKadran"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="25:00"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/ga_yazi_devasa"
            android:visibility="gone" />

        <!-- v5.7: yatay tam ekran flip saat -->
        <TextView
            android:id="@+id/fullscreenButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="@string/fs_open"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/ga_yazi_normal" />

        <!-- v10.12 · D19: nefes stüdyosu kısayolu -->
        <TextView
            android:id="@+id/nefesButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="@string/fo_nefes_chip"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/ga_yazi_normal" />

        <!-- v10.45 · Madde #7: mini uygulama (PiP) düğmesi -->
        <TextView
            android:id="@+id/miniModButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="@string/w45_mini_mod"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/ga_yazi_normal" />

        <!-- v6.5: bildirim kapalıysa uyarı şeridi -->
        <TextView
            android:id="@+id/notifBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="?attr/colorPrimaryContainer"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:lineSpacingMultiplier="1.2"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:text="@string/tn_banner_off"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/ga_yazi_kucuk"
            android:visibility="gone" />

        <!-- Hazır süreler (sadece geri sayımda görünür) -->
        <LinearLayout
            android:id="@+id/presetRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/presetFocus"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:insetTop="4dp"
                android:insetBottom="4dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/preset_focus"
                android:textSize="@dimen/ga_yazi_kucuk" />

            <Button
                android:id="@+id/presetShort"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:insetTop="4dp"
                android:insetBottom="4dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/preset_short"
                android:textSize="@dimen/ga_yazi_kucuk" />

            <Button
                android:id="@+id/presetLong"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:insetTop="4dp"
                android:insetBottom="4dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/preset_long"
                android:textSize="@dimen/ga_yazi_kucuk" />

            <Button
                android:id="@+id/presetCustom"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:insetTop="4dp"
                android:insetBottom="4dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/preset_custom"
                android:textSize="@dimen/ga_yazi_kucuk" />
        </LinearLayout>

        <!-- Kontrol butonları -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/resetButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reset" />

            <Button
                android:id="@+id/mainAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:fontFamily="@font/poppins_semibold"
                android:minWidth="150dp"
                android:text="@string/start" />

            <Button
                android:id="@+id/lapButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lap"
                android:visibility="gone" />
        </LinearLayout>

        <!-- v10.78: Ekran Görüntüsü 1 - İstatistikler ve Ders Seçimi Butonları -->
        <LinearLayout
            android:id="@+id/layoutKpssSayacButonlar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSayacIstatistikGor"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:foreground="?attr/selectableItemBackground"
                android:text="@string/ksa_btn_istatistik"
                android:textSize="@dimen/ga_yazi_kucuk" />

            <Button
                android:id="@+id/btnSayacDersSec"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:foreground="?attr/selectableItemBackground"
                android:text="@string/ksa_btn_ders_sec"
                android:textSize="@dimen/ga_yazi_kucuk" />
        </LinearLayout>

        <!-- Odak sesleri -->
        <TextView
            android:id="@+id/txtOdakSesleriBaslik"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/sounds_header"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/ga_yazi_orta" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/sounds_hint"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/ga_yazi_mini" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/soundRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Çalan sesin animasyonlu görseli -->
        <com.gunlukasistan.app.EqualizerView
            android:id="@+id/eqView"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:visibility="gone" />

        <!-- v10.84: Arka Plan Müzik & Radyo (YouTube, Spotify vb.) Medya Kumandası -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardArkaPlanMedya"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="visible"
            app:cardCornerRadius="@dimen/ga_kose_buyuk"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Başlık ve Durum -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎵"
                        android:textSize="@dimen/ga_yazi_dev" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtArkaPlanMedyaBaslik"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="@string/apm_baslik"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/ga_yazi_normal" />

                        <TextView
                            android:id="@+id/txtArkaPlanMedyaDurum"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/apm_durum_hazir"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="@dimen/ga_yazi_kucuk" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Kumanda Butonları (Geri / Oynat-Dur / İleri) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnMedyaGeri"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="@string/apm_btn_geri"
                        android:textSize="@dimen/ga_yazi_kucuk" />

                    <Button
                        android:id="@+id/btnMedyaOynatDur"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1.2"
                        android:text="@string/apm_btn_oynat_dur"
                        android:textSize="@dimen/ga_yazi_kucuk" />

                    <Button
                        android:id="@+id/btnMedyaIleri"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/apm_btn_ileri"
                        android:textSize="@dimen/ga_yazi_kucuk" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Turlar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/lapCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/ga_kose_buyuk"
            app:cardElevation="2dp">

            <TextView
                android:id="@+id/lapText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.5"
                android:padding="18dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/ga_yazi_normal" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Günlük odaklanma özeti -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="?attr/colorSecondaryContainer"
            app:cardCornerRadius="@dimen/ga_kose_buyuk"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/todayStat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/ga_yazi_normal" />

                <!-- v10.12 · D20: kendinle maç satırı -->
                <TextView
                    android:id="@+id/ghostText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/ga_yazi_kucuk"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
