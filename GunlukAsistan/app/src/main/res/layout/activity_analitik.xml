<?xml version="1.0" encoding="utf-8"?>
<!-- v7.38: Detaylı ilerleme analitiği -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <!-- Üst bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp">

        <TextView
            android:contentDescription="@string/cd_kapat"
            android:id="@+id/anClose"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="✕"
            android:textSize="@dimen/ga_yazi_buyuk" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/an_title"
            android:textSize="@dimen/ga_yazi_orta" />

        <TextView
            android:contentDescription="@string/cd_paylas"
            android:id="@+id/anShare"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="↗"
            android:textSize="@dimen/ga_yazi_buyuk" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/anContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <!-- ── Akıllı çıkarımlar ── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/anInsightCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="@dimen/ga_kose_buyuk"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/an_insights"
                        android:textSize="@dimen/ga_yazi_orta" />

                    <LinearLayout
                        android:id="@+id/anInsights"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Saat dağılımı ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="@dimen/ga_kose_buyuk"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/an_hours_title"
                        android:textSize="@dimen/ga_yazi_orta" />

                    <TextView
                        android:id="@+id/anHourSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:alpha="0.75"
                        android:textSize="@dimen/ga_yazi_kucuk" />

                    <com.gunlukasistan.app.BarChartView
                        android:id="@+id/anHourChart"
                        android:layout_width="match_parent"
                        android:layout_height="120dp" />

                    <LinearLayout
                        android:id="@+id/anSlots"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Haftanın günleri ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="@dimen/ga_kose_buyuk"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/an_days_title"
                        android:textSize="@dimen/ga_yazi_orta" />

                    <TextView
                        android:id="@+id/anDaySub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:alpha="0.75"
                        android:textSize="@dimen/ga_yazi_kucuk" />

                    <com.gunlukasistan.app.BarChartView
                        android:id="@+id/anDayChart"
                        android:layout_width="match_parent"
                        android:layout_height="110dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Haftalık eğilim ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="@dimen/ga_kose_buyuk"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/an_trend_title"
                        android:textSize="@dimen/ga_yazi_orta" />

                    <TextView
                        android:id="@+id/anTrendSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:alpha="0.75"
                        android:textSize="@dimen/ga_yazi_kucuk" />

                    <com.gunlukasistan.app.BarChartView
                        android:id="@+id/anTrendChart"
                        android:layout_width="match_parent"
                        android:layout_height="110dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Kurs hızı ve bitiş tahmini ── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/anCourseCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="@dimen/ga_kose_buyuk"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/an_courses_title"
                        android:textSize="@dimen/ga_yazi_orta" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:alpha="0.75"
                        android:text="@string/an_courses_sub"
                        android:textSize="@dimen/ga_yazi_kucuk" />

                    <LinearLayout
                        android:id="@+id/anCourses"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Aylık karşılaştırma ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/ga_kose_buyuk"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/an_months_title"
                        android:textSize="@dimen/ga_yazi_orta" />

                    <TextView
                        android:id="@+id/anMonthSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:alpha="0.75"
                        android:textSize="@dimen/ga_yazi_kucuk" />

                    <LinearLayout
                        android:id="@+id/anMonths"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
