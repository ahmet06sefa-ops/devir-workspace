<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Başlık -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/krBaslik"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/vk_baslik"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/krKapat"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@android:drawable/ic_menu_close_clear_cancel" />
        </LinearLayout>

        <!-- BÖLÜM 1: SESLİ GÜNDEM & VAKİT BRİFİNGİ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/vk_grp_brifing"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewElevatedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="@dimen/ga_kose_orta"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/krBrifingBaslik"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="🌅 Sabah Günaydın &amp; Vakit Brifingi"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/ga_yazi_orta" />

                <TextView
                    android:id="@+id/krBrifingMetin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Günaydın! Brifing metni hazırlanıyor..."
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/ga_yazi_normal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/krBtnSesliOku"
                    style="@style/Widget.Material3.Button.ElevatedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/vk_btn_sesli"
                    app:icon="@android:drawable/ic_lock_silent_mode_off" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BÖLÜM 2: HAFTALIK VERİMLİLİK KARNESİ & NOTU -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/vk_grp_karne"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewElevatedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="@dimen/ga_kose_orta"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- Harf Notu Rozeti -->
                <TextView
                    android:id="@+id/krHarfNotu"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/co_bar_bg"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:text="A"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/ga_yazi_dev" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/krOdakSaat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Haftalık Toplam: 14.5 Saat"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/ga_yazi_orta" />

                    <TextView
                        android:id="@+id/krEnVerimliGun"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="En Verimli Gün: Çarşamba"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/ga_yazi_kucuk" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BÖLÜM 3: AI KOÇ TAVSİYESİ & GELİŞİM İPUÇLARI -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/vk_grp_tavsiye"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewElevatedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="@dimen/ga_kose_orta"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/krKocTavsiyesi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.2"
                    android:text="AI koç analizi yapılıyor..."
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/ga_yazi_normal" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
