<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/g_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Üst Başlık ve Kapatma Butonu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtCanvaKartSimge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱️"
            android:textSize="@dimen/ga_yazi_dev" />

        <TextView
            android:id="@+id/txtCanvaKartAd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_semibold"
            android:text="⏱️ Çalışma Zamanı &amp; Pomodoro"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/ga_yazi_orta" />

        <Button
            android:id="@+id/btnCanvaKartKapat"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="✕ Kapa"
            android:textColor="?attr/colorError"
            android:textSize="@dimen/ga_yazi_kucuk"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Canlı Özet / İçerik Satırı -->
    <TextView
        android:id="@+id/txtCanvaKartOzet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:text="Odak oturumları ve geri sayım. Dokunarak zamanlayıcıyı hemen açın."
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/ga_yazi_normal" />

    <!-- Alt Aksiyon Şeridi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCanvaKartAc"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:backgroundTint="?attr/colorPrimary"
            android:text="🚀 Uygulamayı Aç / Çalıştır"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="@dimen/ga_yazi_kucuk"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
