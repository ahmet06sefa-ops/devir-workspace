<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <!-- Üst Başlık Barı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/colorSurfaceVariant"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnGeri"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/txtBaslik"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_semibold"
            android:text="🎨 Canva Çalışma Ekranı (10 Uygulama Arayüzü)"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/ga_yazi_orta" />
    </LinearLayout>

    <!-- Akıllı Öneri & Tekrar Dene Aksiyon Şeridi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/btnCanvaOner"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="?attr/colorPrimary"
            android:text="💡 Akıllı Öneri (Öner)"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="@dimen/ga_yazi_mini"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCanvaTekrarDene"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="?attr/colorSecondaryContainer"
            android:text="🔄 Tekrar Dene (Karıştır)"
            android:textColor="?attr/colorOnSecondaryContainer"
            android:textSize="@dimen/ga_yazi_mini"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tümünü Aç & Kapat Alt Şeridi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/btnCanvaTumunuAc"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="⚡ Tümünü Aç"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/ga_yazi_mini"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCanvaTumunuKapat"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="✕ Tümünü Kapat"
            android:textColor="?attr/colorError"
            android:textSize="@dimen/ga_yazi_mini"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 10 Modül Aç / Kapa Seçici Barı (HorizontalScrollView / Çip Listesi) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutCanvaAcKapaListesi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Canva Yaratıcı Çalışma Alanı (Sürükle-Bırak Destekli 10 Uygulama Gövdesi) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/layoutCanvaCalismaAlani"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingBottom="36dp" />
    </ScrollView>
</LinearLayout>
