<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Üst Başlık ve Geri Butonu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/btnGeri"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/app_name"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="?attr/colorOnSurface" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtBaslik"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/eom_baslik"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/ga_yazi_buyuk"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtAltBaslik"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/eom_altbaslik"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/ga_yazi_kucuk" />
            </LinearLayout>
        </LinearLayout>

        <!-- KART 1: Modül 1 - Evrensel 200-Madde İndeks & Arama -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="@dimen/ga_kose_orta"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/eom_mod1_indeks"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/ga_yazi_normal"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtAramaSonuc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="🌐 200-Madde Evrensel İndeks hazır. Yaşam (100 madde) ve Ders (100 madde) katalogları çapraz taranabilir."
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/ga_yazi_kucuk" />

                <Button
                    android:id="@+id/btnAramaTest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="@string/eom_btn_arama_test"
                    android:textSize="@dimen/ga_yazi_kucuk" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- KART 2: Modül 2 & 5 - Yaşam-Ders Denge Endeksi & Evrensel Ustalık Rütbesi -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="@dimen/ga_kose_orta"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/eom_mod2_denge"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/ga_yazi_normal"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtDengeVeRutbe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="⚖️ Denge Endeksi: 85/100 (Mükemmel) · 👑 Ustalık Rütbesi: Evrensel Usta (+250 XP)"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/ga_yazi_kucuk" />

                <Button
                    android:id="@+id/btnDengeTest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="@string/eom_btn_denge_test"
                    android:textSize="@dimen/ga_yazi_kucuk" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- KART 3: Modül 3 & 4 - Manuel Otonomi Derecesi Override & Çevrimdışı Kasa -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="@dimen/ga_kose_orta"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/eom_mod3_otonomi"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/ga_yazi_normal"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtOtonomiDurum"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="🎛️ 100% Manuel Kontrol Modu: Tüm kontrol kullanıcıda.\n🔒 %100 Çevrimdışı Evrensel Kasa doğrulandı."
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/ga_yazi_kucuk" />

                <Button
                    android:id="@+id/btnOtonomiTest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="@string/eom_btn_otonomi_test"
                    android:textSize="@dimen/ga_yazi_kucuk" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- KART 4: Modül 6 & 7 - Evrensel Hızlı Komut Paleti & Sistem Denetçisi -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="@dimen/ga_kose_orta"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/eom_mod6_komut"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/ga_yazi_normal"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtKomutVeSaglik"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="⚡ Komut Paleti Hazır: 5 kilit evrensel işlem tek tuşla çalışır.\n✅ Sistem Sağlığı: Android SDK 34 Uyumlu · 0 Crash"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/ga_yazi_kucuk" />

                <Button
                    android:id="@+id/btnKomutTest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="@string/eom_btn_komut_test"
                    android:textSize="@dimen/ga_yazi_kucuk" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
