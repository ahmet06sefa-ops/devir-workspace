<?xml version="1.0" encoding="utf-8"?>
<!--
  v7.1 — Hızlı kaydet ekranı.
  Diyalog gibi görünür: ortada bir kart, arkası yarı saydam.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="18dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardCornerRadius="@dimen/ga_kose_dev"
        app:cardElevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Başlık -->
            <TextView
                android:id="@+id/qaTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/qa_title_task"
                android:textSize="@dimen/ga_yazi_buyuk"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <!-- Tür seçici -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/qaTabTask"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/qa_tab_task"
                    android:textSize="@dimen/ga_yazi_normal"
                    app:cornerRadius="14dp" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/qaTabNote"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/qa_tab_note"
                    android:textSize="@dimen/ga_yazi_normal"
                    app:cornerRadius="14dp" />
            </LinearLayout>

            <!-- Yazı kutusu -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/qaInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/qa_hint_task"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="6"
                    android:minLines="2"
                    android:textSize="@dimen/ga_yazi_orta" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Hatırlatma -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/qaDue"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/qa_due_button"
                android:textSize="@dimen/ga_yazi_normal" />

            <!-- Alt butonlar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/qaCancel"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cancel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/qaSave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/qa_save"
                    app:cornerRadius="16dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
