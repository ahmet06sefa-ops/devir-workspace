<?xml version="1.0" encoding="utf-8"?>
<!--
  v8.2 · Öneri 7: basılan kart hafifçe içeri çöker.

  Neden stateListAnimator:
  Her karta ayrı ayrı dokunma dinleyicisi yazmak 71 layout'u
  değiştirmek demekti. stateListAnimator tek stil üzerinden
  tüm MaterialCardView'lara uygulanabiliyor ve tıklama
  dinleyicilerini hiç bozmuyor.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator
                android:duration="90"
                android:propertyName="scaleX"
                android:valueTo="0.972"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
            <objectAnimator
                android:duration="90"
                android:propertyName="scaleY"
                android:valueTo="0.972"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator
                android:duration="160"
                android:propertyName="scaleX"
                android:valueTo="1.0"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/overshoot" />
            <objectAnimator
                android:duration="160"
                android:propertyName="scaleY"
                android:valueTo="1.0"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/overshoot" />
        </set>
    </item>
</selector>
