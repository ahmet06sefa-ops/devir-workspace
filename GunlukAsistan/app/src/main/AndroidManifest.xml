    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!--
      v9.7 · Öneri 45: konuma bağlı hatırlatma.

      ÖNEMLİ: ACCESS_BACKGROUND_LOCATION BİLİNÇLİ OLARAK YOK.
      Arka planda sürekli konum takibi yapmıyoruz; yalnızca uygulama
      açıkken ve günlük özet alarmında `getLastKnownLocation` okunuyor.
      Bu izin olmadan Play Store'un ek gerekçe formu da gerekmiyor.

      İkisi de required=false: konum izni verilmeyen cihazda uygulamanın
      kalan 200+ özelliği sorunsuz çalışmalı.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

